{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eju.local/schemas/paper.schema.json",
  "title": "EJUPaper",
  "type": "object",
  "required": [
    "schemaVersion",
    "examFamily",
    "stableCode",
    "title",
    "session",
    "syllabusVersion",
    "source",
    "forms"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1, 2] },
    "examFamily": { "type": "string", "const": "EJU" },
    "paperId": { "type": "string" },
    "stableCode": { "type": "string" },
    "title": { "type": "string" },
    "session": { "type": "string" },
    "syllabusVersion": { "type": "string" },
    "completeness": { "type": "string", "enum": ["COMPLETE", "PARTIAL", "SAMPLE"] },
    "availableModes": { "type": "array", "items": { "type": "string", "enum": ["PRACTICE", "SECTION", "MOCK"] } },
    "source": { "type": "object" },
    "forms": {
      "type": "array",
      "items": { "$ref": "https://eju.local/schemas/common.schema.json#/$defs/form" }
    },
    "questionCount": { "type": "integer" },
    "contentRevision": { "type": "string" },
    "contentKind": { "type": "string", "enum": ["SOURCE", "SYNTHETIC", "DERIVED"] },
    "expectedStructure": { "type": "object" },
    "reviewSummary": { "type": "object" }
  }
}
