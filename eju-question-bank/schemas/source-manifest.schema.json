{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eju.local/schemas/source-manifest.schema.json",
  "title": "EJUSourceManifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceId",
    "examFamily",
    "session",
    "subject",
    "language",
    "syllabusVersion",
    "files",
    "rights",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "sourceId": { "type": "string" },
    "inventoryId": { "type": "string" },
    "examFamily": { "type": "string", "const": "EJU" },
    "session": { "type": "string" },
    "subject": { "type": "string", "enum": ["JAPANESE", "SCIENCE", "JAPAN_AND_WORLD", "MATHEMATICS"] },
    "language": { "type": "string", "enum": ["ja", "en"] },
    "syllabusVersion": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "path", "fileName", "sizeBytes", "sha256"],
        "properties": {
          "role": { "type": "string", "enum": ["QUESTION_BOOKLET", "ANSWER_KEY", "AUDIO", "TRANSCRIPT", "OTHER"] },
          "path": { "type": "string" },
          "fileName": { "type": "string" },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "pageCount": { "type": "integer", "minimum": 1 },
          "durationMs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "rights": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PRIVATE_STUDY", "INTERNAL_REVIEW", "PUBLIC_LICENSED", "COMMERCIAL_LICENSED", "SUSPENDED", "UNKNOWN", "REVIEW_REQUIRED"]
        },
        "note": { "type": "string" },
        "expiresAt": { "type": "string" },
        "basis": { "type": "string" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
