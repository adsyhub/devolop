                  "correctAnswer": {
                    "type": "SINGLE_CHOICE",
                    "optionKey": "1"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
```

## 25.3 导入校验

必须校验：

- JSON Schema；
- 来源存在；
- 许可有效；
- 等级只为 N1/N2；
- 题型与等级匹配；
- 题组代码唯一；
- 问题稳定键唯一；
- 选项键唯一；
- 正确答案存在；
- 音频文件存在；
- 音频时长合法；
- 素材引用存在；
- 内容 hash 去重；
- 富文本结构合法；
- ruby 结构合法；
- 不包含危险 HTML；
- 导入错误可追溯。

不得部分静默失败。

