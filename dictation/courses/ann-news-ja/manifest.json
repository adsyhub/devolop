  "sentences": [
    {
      "startTime": 3.679,
      "endTime": 6.162,
      "sourceText": "事件は山口県美祢市で起きました。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "事件は山口県美祢市で起きました。",
      "id": "s_e1e8fe50d0e5ae409ae5f9e8"
    },
    {
      "startTime": 6.179,
      "endTime": 6.662,
      "sourceText": "通報は",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "marker",
      "practiceEligible": false,
      "jaText": "通報は",
      "id": "s_642629e457ad9aab2370df23"
    },
    {
      "startTime": 9.44,
      "endTime": 11.39,
      "sourceText": "28日午後6時頃。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "28日午後6時頃。",
      "id": "s_847246e6f3740735b18df76d"
    },
    {
      "startTime": 15.599,
      "endTime": 18.518,
      "sourceText": "父がちまみれで倒れている。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "父がちまみれで倒れている。",
      "id": "s_1ffd9b2326ca371414f1c722"
    },
    {
      "startTime": 20.439,
      "endTime": 24.669,
      "sourceText": "現場は創業から100年を過ぎた偽。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "現場は創業から100年を過ぎた偽。",
      "id": "s_76328870df3c2b04e980a73d"
    },
    {
      "startTime": 26.24,
      "endTime": 28.23,
      "sourceText": "1階が店舗で2階が住となっています。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "1階が店舗で2階が住となっています。",
      "id": "s_7cc7d49d7e60f8233dd29b65"
    },
    {
      "startTime": 31.32,
      "endTime": 40.27,
      "sourceText": "警察が駆けつけたところ、2階で店主の斎藤和正さん80歳と70代の妻が倒れて",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "警察が駆けつけたところ、2階で店主の斎藤和正さん80歳と70代の妻が倒れて",
      "id": "s_15a4d28996829c5bab9e25e0"
    },
    {
      "startTime": 44.6,
      "endTime": 49.79,
      "sourceText": "この店は名物のまま人気で地元局が取材していました。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "この店は名物のまま人気で地元局が取材していました。",
      "id": "s_8cdb3868279d83fe2316c1bb"
    },
    {
      "startTime": 52.399,
      "endTime": 56.229,
      "sourceText": "ウ一饅とあったんですが看板の方ではない",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "ウ一饅とあったんですが看板の方ではない",
      "id": "s_e1017a9bce75a2d738e78f1b"
    },
    {
      "startTime": 63.44,
      "endTime": 64.996,
      "sourceText": "斎藤さんは頭などを鈍器のようなもので殴られた後がありその場で死亡が確認されました。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "斎藤さんは頭などを鈍器のようなもので殴られた後がありその場で死亡が確認されました。",
      "id": "s_82f8619633bc9399d1b3afc0"
    },
    {
      "startTime": 64.996,
      "endTime": 66.144,
      "sourceText": "妻は頭蓋骨を骨折する重症ですが反時は意識があり入院しています。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "妻は頭蓋骨を骨折する重症ですが反時は意識があり入院しています。",
      "id": "s_766a0ca7e5b9ff01ee46cc6e"
    },
    {
      "startTime": 66.144,
      "endTime": 66.553,
      "sourceText": "遺体見から今日で",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "遺体見から今日で",
      "id": "s_1205bfe414bee3a88d7d2959"
    },
    {
      "startTime": 84.72,
      "endTime": 85.07,
      "sourceText": "4日目。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "marker",
      "practiceEligible": false,
      "jaText": "4日目。",
      "id": "s_ec392f1875a9f8adf0855a69"
    },
    {
      "startTime": 86.479,
      "endTime": 92.75,
      "sourceText": "これまでに凶器は見つかっておらず、犯人の特定には至っていないということです。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "これまでに凶器は見つかっておらず、犯人の特定には至っていないということです。",
      "id": "s_7e8a604c3261c77e88e3181d"
    },
    {
      "startTime": 96.2,
      "endTime": 99.39,
      "sourceText": "美祢市は古くからの石灰石の産地。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "美祢市は古くからの石灰石の産地。",
      "id": "s_6f807d3e8141034905b2839e"
    },
    {
      "startTime": 100.96,
      "endTime": 108.949,
      "sourceText": "名物のまま採掘され、土がついた石灰石をイメージしたもので道の駅にも置いてあります。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "名物のまま採掘され、土がついた石灰石をイメージしたもので道の駅にも置いてあります。",
      "id": "s_ff267d919d64a1a9c093af8f"
    },
    {
      "startTime": 127.159,
      "endTime": 128.99,
      "sourceText": "40",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "marker",
      "practiceEligible": false,
      "jaText": "40",
      "id": "s_90392f63594362f07ebf38be"
    },
    {
      "startTime": 132.12,
      "endTime": 134.841,
      "sourceText": "あそこは年中無なんですよ。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "あそこは年中無なんですよ。",
      "id": "s_4d8874124917e16f549a6a53"
    },
    {
      "startTime": 134.906,
      "endTime": 135.256,
      "sourceText": "私",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "marker",
      "practiceEligible": false,
      "jaText": "私",
      "id": "s_350cdadbbe4bb79df8c399ab"
    },
    {
      "startTime": 135.959,
      "endTime": 136.749,
      "sourceText": "28日に病院に歩いて行ったんですよ。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "28日に病院に歩いて行ったんですよ。",
      "id": "s_3bff8fb8346531d50c6ea370"
    },
    {
      "startTime": 140.84,
      "endTime": 144.109,
      "sourceText": "朝10時にそん時カーテンが全部閉まってたから",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "朝10時にそん時カーテンが全部閉まってたから",
      "id": "s_03c1c42d079f4bb3ef165980"
    },
    {
      "startTime": 151.2,
      "endTime": 156.19,
      "sourceText": "家の中が荒らされた形跡はなく売上金もそのままでした。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "家の中が荒らされた形跡はなく売上金もそのままでした。",
      "id": "s_17b70512da2fa280876b2474"
    },
    {
      "startTime": 157.519,
      "endTime": 160.91,
      "sourceText": "被害者の周辺ではトラブルも確認されておらず",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "被害者の周辺ではトラブルも確認されておらず",
      "id": "s_0847a226767ac5f842cf421c"
    },
    {
      "startTime": 162.08,
      "endTime": 167.79,
      "sourceText": "警察はトクリュウも含む第3者による犯行も視野に捜査を続け",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "警察はトクリュウも含む第3者による犯行も視野に捜査を続け",
      "id": "s_77398215b73a3e9467148ceb"
    }
