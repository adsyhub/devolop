      "endTime": 374.478,
      "sourceText": "怖かった。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "marker",
      "practiceEligible": false,
      "jaText": "怖かった。",
      "id": "s_7ffa1097017f5c4d6f59d874"
    },
    {
