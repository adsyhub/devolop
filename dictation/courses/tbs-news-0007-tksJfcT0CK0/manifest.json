    {
      "startTime": 59.879,
      "endTime": 76.479,
      "sourceText": "震度7を観測した川町家族4すごい7時からですよね。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "震度7を観測した川町家族4すごい7時からですよね。",
      "id": "s_acc9633f4fbdbde0edb6299f"
    },
    {
      "startTime": 76.479,
      "endTime": 76.829,
      "sourceText": "お風呂が。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "marker",
      "practiceEligible": false,
      "jaText": "お風呂が。",
      "id": "s_e76b5cf43fbd8adf5f49d0fd"
    },
    {
      "startTime": 79.08,
      "endTime": 83.759,
      "sourceText": "それでも娘の喜ぶ顔が見たいかいい。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "それでも娘の喜ぶ顔が見たいかいい。",
      "id": "s_c6e4d1d895450d384af60984"
    },
    {
      "startTime": 83.759,
      "endTime": 95.09,
      "sourceText": "お父さんが隣町で1何?",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "お父さんが隣町で1何?",
