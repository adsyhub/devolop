  "sentences": [
    {
      "startTime": 0.16,
      "endTime": 1.06,
      "sourceText": "元が日本に攻めった際に使っていた矢の一部で",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "元が日本に攻めった際に使っていた矢の一部で",
      "id": "s_651aeeb0a278ca10650268c2"
    },
    {
      "startTime": 1.06,
      "endTime": 2.26,
      "sourceText": "矢ハズと呼ばれる矢の末端部分だと分かったということです。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "矢ハズと呼ばれる矢の末端部分だと分かったということです。",
      "id": "s_fe763cead58e65593e8a7ee9"
    },
    {
      "startTime": 2.26,
      "endTime": 3.267,
      "sourceText": "元寇で使用したのではないかと指摘しています。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "元寇で使用したのではないかと指摘しています。",
      "id": "s_29288836e649cfaaa12feda7"
    },
    {
      "startTime": 11.48,
      "endTime": 13.176,
      "sourceText": "重要文化財の大発見ですね。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "重要文化財の大発見ですね。",
      "id": "s_85bbdbbb4646db5ee38bedc1"
    },
