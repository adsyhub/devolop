  "sentences": [
    {
      "startTime": 4.44,
      "endTime": 7.29,
      "sourceText": "夏休み最後の日曜日。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "夏休み最後の日曜日。",
      "id": "s_a031e016180fa4881ab8bc4b"
    },
    {
      "startTime": 8.4,
      "endTime": 11.464,
      "sourceText": "昨日東京町田市の公園には間もなく新学を迎える子供たちの姿がありました。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "昨日東京町田市の公園には間もなく新学を迎える子供たちの姿がありました。",
      "id": "s_575725b49925b7e3397db2e2"
    },
    {
      "startTime": 20.24,
      "endTime": 21.179,
      "sourceText": "楽しかった。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "marker",
      "practiceEligible": false,
      "jaText": "楽しかった。",
      "id": "s_ec017a0c66ef324aa6d665ad"
    },
    {
      "startTime": 21.187,
      "endTime": 23.232,
      "sourceText": "夏休みはあっという間です。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "夏休みはあっという間です。",
      "id": "s_74a668c2cf2bd1d972806810"
    },
    {
      "startTime": 25.359,
      "endTime": 28.351,
      "sourceText": "海に行ったりしたからとても楽しかった。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "海に行ったりしたからとても楽しかった。",
      "id": "s_4fb85c29180593c3bc686ed0"
    },
    {
      "startTime": 30.199,
      "endTime": 31.699,
      "sourceText": "旅行でいこたちの家行ったのが一番楽しかった。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "旅行でいこたちの家行ったのが一番楽しかった。",
      "id": "s_bd5af5b3ddfaa4657b0f3f00"
    },
    {
      "startTime": 31.699,
      "endTime": 33.281,
      "sourceText": "学校は正直嫌だけど、みんなに会うのは楽しみ。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "学校は正直嫌だけど、みんなに会うのは楽しみ。",
      "id": "s_1196f2a19e6a097afcc96797"
    },
    {
      "startTime": 39.32,
      "endTime": 41.123,
      "sourceText": "うん。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "marker",
      "practiceEligible": false,
      "jaText": "うん。",
      "id": "s_cce23d0b0b328676532b1099"
    },
    {
      "startTime": 41.8,
      "endTime": 43.603,
      "sourceText": "うん。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "marker",
      "practiceEligible": false,
      "jaText": "うん。",
      "id": "s_36eb2e262bf730fd642674be"
    },
    {
      "startTime": 47.36,
      "endTime": 48.36,
      "sourceText": "物づりをしたり、火起こしをしたり、",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "物づりをしたり、火起こしをしたり、",
      "id": "s_2a2a8c335c7d471922cc0150"
    },
    {
      "startTime": 48.36,
      "endTime": 50.451,
      "sourceText": "自然の中で自由に遊ぶことのできるこちらの公園にはある特徴があります。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "自然の中で自由に遊ぶことのできるこちらの公園にはある特徴があります。",
      "id": "s_9983267b89b1591267ffd720"
    },
    {
      "startTime": 58.559,
      "endTime": 61.521,
      "sourceText": "両手での切り持ってらでこう聞く。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "両手での切り持ってらでこう聞く。",
      "id": "s_177a2fb0b92771833b78e10a"
    },
    {
      "startTime": 63.44,
      "endTime": 64.385,
      "sourceText": "子供の遊びを支える専門のスタッフが見守ります。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "子供の遊びを支える専門のスタッフが見守ります。",
      "id": "s_1b005d02eec02ed4a5d954ea"
    },
    {
      "startTime": 64.385,
      "endTime": 65.248,
      "sourceText": "スタッフは子供の心を傷つけないし方について",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "スタッフは子供の心を傷つけないし方について",
      "id": "s_0c770fb8ac52bc18f7f851e3"
    },
    {
      "startTime": 65.248,
      "endTime": 66.549,
      "sourceText": "の研修も受けていて子供たちは悩みを相談することもできます。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "の研修も受けていて子供たちは悩みを相談することもできます。",
      "id": "s_958abd9b0679e278c8d058cb"
    },
    {
      "startTime": 77.84,
      "endTime": 81.53,
      "sourceText": "どうぞ。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "marker",
      "practiceEligible": false,
      "jaText": "どうぞ。",
      "id": "s_3bac5f1a3d2d6930bf11a095"
    },
    {
      "startTime": 96.479,
      "endTime": 97.439,
      "sourceText": "夏休みが終わりに近づく今の時期。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "夏休みが終わりに近づく今の時期。",
      "id": "s_cef46f281b2406ac2958f1ce"
    },
    {
      "startTime": 97.439,
      "endTime": 99.569,
      "sourceText": "新学期が始まる不安などから悩みを抱える子供たちも少なくはありません。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "新学期が始まる不安などから悩みを抱える子供たちも少なくはありません。",
      "id": "s_635105d29f9a65221e148e77"
    },
    {
      "startTime": 108.119,
      "endTime": 109.909,
      "sourceText": "明日学校に行きたくない。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "明日学校に行きたくない。",
      "id": "s_b60c629140933c7c46aa7dae"
    },
    {
      "startTime": 110.64,
      "endTime": 112.84,
      "sourceText": "そんな時学校でも家でも",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "そんな時学校でも家でも",
      "id": "s_a5467e8353e914fa9e7880dd"
    },
    {
      "startTime": 112.84,
      "endTime": 120.869,
      "sourceText": "ない別の居場所が見つかるきっかけになるかもしれないのがハッシュタグ学校無理でも",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "ない別の居場所が見つかるきっかけになるかもしれないのがハッシュタグ学校無理でも",
      "id": "s_92080efd7da790db7164d07c"
    },
    {
      "startTime": 121.039,
      "endTime": 122.629,
      "sourceText": "ここあるよキャンペーンです。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "ここあるよキャンペーンです。",
      "id": "s_13dbbd82157159e1fd3380b8"
    },
    {
      "startTime": 124.52,
      "endTime": 133.583,
      "sourceText": "全国各地の公園や図書館など50箇所以近くにない場合の相談窓口も紹介されています。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "全国各地の公園や図書館など50箇所以近くにない場合の相談窓口も紹介されています。",
      "id": "s_964471ba6a7dbc7694ce06c8"
    },
    {
      "startTime": 134.28,
      "endTime": 136.83,
      "sourceText": "余計なことを聞き出すこともなく、あの、",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "余計なことを聞き出すこともなく、あの、",
      "id": "s_698966082605667d82174f2d"
    },
    {
      "startTime": 137.16,
      "endTime": 140.389,
      "sourceText": "相談をしなくても入れる場所というかですね、",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "相談をしなくても入れる場所というかですね、",
      "id": "s_4cc72f1e6267dea177ab1ace"
    },
    {
      "startTime": 140.8,
      "endTime": 145.99,
      "sourceText": "学校と家以外の社会があるんだよ、世界があるんだよ。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "学校と家以外の社会があるんだよ、世界があるんだよ。",
      "id": "s_bf9ff4194804527762c7a318"
    },
    {
      "startTime": 146.16,
      "endTime": 150.669,
      "sourceText": "様々な道をこう選ぶことができるんだよということをですね、",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "様々な道をこう選ぶことができるんだよということをですね、",
      "id": "s_36d95f222968961056daf656"
    },
    {
      "startTime": 150.68,
      "endTime": 155.95,
      "sourceText": "一緒にこう過ごしていく中で子供と一緒に見つけていきたいな。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "一緒にこう過ごしていく中で子供と一緒に見つけていきたいな。",
      "id": "s_72721c60f6a71c8539986fa6"
    },
    {
      "startTime": 157.68,
      "endTime": 161.109,
      "sourceText": "ここからは親御さんがどう接するべきかという観点ですね。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "ここからは親御さんがどう接するべきかという観点ですね。",
      "id": "s_3f9e401f5751608bbde12786"
    },
    {
      "startTime": 172.879,
      "endTime": 179.206,
      "sourceText": "ま、確かに休みたいって言われると理由を聞きたくなるたくなりますけどね。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "ま、確かに休みたいって言われると理由を聞きたくなるたくなりますけどね。",
      "id": "s_51555bfb9f2e3f3b44b0ae86"
    },
    {
      "startTime": 179.4,
      "endTime": 182.4,
      "sourceText": "やっぱりまずは尊重してあげるってことみたいですね。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "やっぱりまずは尊重してあげるってことみたいですね。",
      "id": "s_f08f0634bc65f085f4992016"
    },
    {
      "startTime": 182.4,
      "endTime": 182.427,
      "sourceText": "そうですね。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "marker",
      "practiceEligible": false,
      "jaText": "そうですね。",
      "id": "s_e6c224f35a5b0ae4dbd5deba"
    },
    {
      "startTime": 182.427,
      "endTime": 182.629,
      "sourceText": "そこでまた一歩追い詰めてしまうとせっかく振り絞った勇気もまた折れてしまうこともありますから",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "そこでまた一歩追い詰めてしまうとせっかく振り絞った勇気もまた折れてしまうこともありますから",
      "id": "s_540540d7514f77a1b71093de"
    },
    {
      "startTime": 182.629,
      "endTime": 182.979,
      "sourceText": "ぐっと大人が我慢する時間も大事だということなんですね。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "ぐっと大人が我慢する時間も大事だということなんですね。",
      "id": "s_03f6ddd9f2c95abb9ab5aca2"
    },
    {
      "startTime": 187.799,
      "endTime": 188.313,
      "sourceText": "やっぱり基本的には学校に行くというのは手段であり目的ではない。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "やっぱり基本的には学校に行くというのは手段であり目的ではない。",
      "id": "s_bfe93f64ee04635a1da76df9"
    },
    {
      "startTime": 188.313,
      "endTime": 188.793,
      "sourceText": "それが目的になってしまうとやっぱり子供を追い詰めてしまう。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "それが目的になってしまうとやっぱり子供を追い詰めてしまう。",
      "id": "s_fbc9da55f6599e23845c4a14"
    },
    {
      "startTime": 188.793,
      "endTime": 189.374,
      "sourceText": "そういう環境になってしまいますのでその受け止めてあげる様々な部分がま、",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "そういう環境になってしまいますのでその受け止めてあげる様々な部分がま、",
      "id": "s_82d2c37731abdcae2fbf556c"
    },
    {
      "startTime": 189.374,
      "endTime": 190.119,
      "sourceText": "選択肢があるんだということで休みたいと口にできない子の方が一般的には多いと言われています。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "選択肢があるんだということで休みたいと口にできない子の方が一般的には多いと言われています。",
      "id": "s_2415a2b1e58ce2e4e78d21d4"
    },
    {
      "startTime": 190.119,
      "endTime": 190.318,
      "sourceText": "サインにどう気づけるか。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "サインにどう気づけるか。",
      "id": "s_89415d3c15d43c8e1b2267d1"
    },
    {
      "startTime": 190.318,
      "endTime": 190.418,
      "sourceText": "食欲がない。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "marker",
      "practiceEligible": false,
      "jaText": "食欲がない。",
      "id": "s_ca243cad721c3a22117e23d7"
    },
    {
      "startTime": 190.418,
      "endTime": 190.55,
      "sourceText": "眠れていなそう。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "眠れていなそう。",
      "id": "s_d132d86be9fab0eefe086ced"
    },
    {
      "startTime": 190.55,
      "endTime": 190.749,
      "sourceText": "あとは部屋にこもり気味。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "あとは部屋にこもり気味。",
      "id": "s_55a5a8e90b784e21df8b5a0d"
    },
    {
      "startTime": 190.749,
      "endTime": 219.614,
      "sourceText": "あとはSNS、ま、携帯電話を頻繁に気にするなど。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "あとはSNS、ま、携帯電話を頻繁に気にするなど。",
      "id": "s_08e961d91e878237d650ab06"
    },
    {
      "startTime": 220.36,
      "endTime": 225.647,
      "sourceText": "1つの選択肢としてくださいということですね。",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "dialogue",
      "practiceEligible": true,
      "jaText": "1つの選択肢としてくださいということですね。",
      "id": "s_b61aae8e3e70c485ffe0fa33"
    },
    {
      "startTime": 236.0,
      "endTime": 236.35,
      "sourceText": "።",
      "translationText": "",
      "zhTranslation": "",
      "contentType": "marker",
      "practiceEligible": false,
      "jaText": "።",
      "id": "s_bb5acf3934ce54bfb9595947"
    }
